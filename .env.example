# Скопируйте в .env и заполните. Пустое значение = не задано.

# --- LLM ---
# mock — без модели: записанные ответы для демо-сценариев и поиск по FAQ (ключ не нужен).
# live — Claude API; нужен ANTHROPIC_API_KEY (или профиль `ant auth login`).
LLM_MODE=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60
# Серверный fallback на другую модель, если модель откажется отвечать.
LLM_FALLBACKS=true

# --- Ядро ---
KB_DIR=./knowledge_base
HISTORY_LIMIT=20
PII_MASKING=true
UPSELL_IN_REPLY=false

# --- Доступ ---
# Если задан — POST /api/v1/suggest требует Authorization: Bearer <API_TOKEN>.
API_TOKEN=
# Если задан — /api/v1/kb* требует Authorization: Bearer <ADMIN_TOKEN>. Пусто — открыто (только для локальной разработки).
ADMIN_TOKEN=

# --- Хранилище и логи ---
DB_PATH=./data/app.db
LOG_LEVEL=INFO
LOG_TEXTS=false

# --- amoCRM (этап 2) ---
AMOCRM_MODE=off
