# Скопируйте в .env и заполните. Пустое значение = не задано.

# --- LLM ---
# mock — без модели: записанные ответы для демо-сценариев и поиск по FAQ (ключ не нужен).
# live — настоящие модели: Claude через Anthropic API и/или все модели через шлюз (см. ниже).
LLM_MODE=mock
# Модель по умолчанию — для amoCRM и запросов, где модель не выбрана:
# claude | glm | deepseek | kimi | qwen | grok. На странице прямого вызова модель переключается списком.
LLM_PROVIDER=claude
# Запасные модели через запятую, по порядку: если модель по умолчанию не ответила. Пусто — без запасных.
LLM_FALLBACK_PROVIDERS=
# low | medium | high | xhigh | max. Для моделей шлюза приводится к их уровням (medium → low у GLM и Kimi).
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60

# Claude через Anthropic API: нужен ANTHROPIC_API_KEY (или профиль `ant auth login`).
# Если ключа нет, а шлюз настроен, Claude идёт через шлюз.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Серверный fallback Anthropic API на другую модель, если модель откажется отвечать.
LLM_FALLBACKS=true

# Живая модель за паролем на публичном стенде (при LLM_MODE=mock): все видят записанные ответы,
# а кто ввёл пароль на странице — ответы живых моделей. Нужен шлюз (или ключ Anthropic) ниже.
LIVE_DEMO_PASSWORD=
# Живых запросов в сутки на экземпляр сервиса — страховка; точный предел ставьте квотой ключа в шлюзе.
LIVE_DEMO_DAILY_LIMIT=200

# Шлюз (агрегатор) с OpenAI-совместимым API: New API, OpenRouter, LiteLLM…
# Проще задать командой, она же проверит ключ: python -m app.setup_gateway --url https://<шлюз>/v1
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
# id моделей в шлюзе. Значения по умолчанию — как в New API; для OpenRouter — z-ai/glm-5.3, moonshotai/kimi-k3 и т. п.
LLM_GATEWAY_MODEL_CLAUDE=claude-opus-5
LLM_GATEWAY_MODEL_GLM=glm-5.3
LLM_GATEWAY_MODEL_DEEPSEEK=deepseek-v4-pro
LLM_GATEWAY_MODEL_KIMI=kimi-k3
LLM_GATEWAY_MODEL_QWEN=qwen3.8-max
LLM_GATEWAY_MODEL_GROK=grok-4.7

# --- Ядро ---
KB_DIR=./knowledge_base
HISTORY_LIMIT=20
PII_MASKING=true
UPSELL_IN_REPLY=false

# --- Доступ ---
# Если задан — POST /api/v1/suggest требует Authorization: Bearer <API_TOKEN>.
API_TOKEN=
# Если задан — /api/v1/kb* требует Authorization: Bearer <ADMIN_TOKEN>. Пусто — открыто (только для локальной разработки).
ADMIN_TOKEN=

# --- Хранилище и логи ---
DB_PATH=./data/app.db
LOG_LEVEL=INFO
LOG_TEXTS=false

# --- amoCRM ---
# off — интеграция выключена; mock — поддельный amoCRM из AMOCRM_MOCK_SEED (без аккаунта, для демо);
# live — настоящий аккаунт: нужны AMOCRM_SUBDOMAIN, AMOCRM_TOKEN и WEBHOOK_SECRET.
AMOCRM_MODE=mock
# Секрет в пути вебхука: https://<адрес>/webhooks/amocrm/<WEBHOOK_SECRET>. Обязателен при live.
# В mock без него вебхук выключен (404), а страница «amoCRM (mock)» работает; нужен для имитатора в консоли.
# dev-secret годится только для демо: для live задайте длинную случайную строку.
WEBHOOK_SECRET=dev-secret
AMOCRM_SUBDOMAIN=
# Долгосрочный токен приватной интеграции (amoCRM → Интеграции → ваша интеграция → Ключи).
AMOCRM_TOKEN=
# Если задан — вебхуки от других аккаунтов игнорируются.
AMOCRM_ACCOUNT_ID=
AMOCRM_RPS=5
NOTE_SERVICE_NAME=AI-помощник

# --- Очередь генераций ---
# Пауза после последнего сообщения клиента: несколько сообщений подряд уходят в модель одним обращением.
DEBOUNCE_SECONDS=6
# Менеджер уже ответил сам: upsell_only — только подсказка по допродаже; skip — ничего.
ON_MANAGER_REPLIED=upsell_only
WORKER_CONCURRENCY=3
JOB_MAX_ATTEMPTS=3
JOB_RETRY_SECONDS=60
RETENTION_DAYS=30
